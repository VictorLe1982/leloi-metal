# Dependencies
node_modules
.pnpm-store

# Production build outputs
.next/
out/
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/

# Prisma
prisma/*.db
prisma/*.db-journal

# Uploads & Temp
uploads/
temp/
scratch/

# Working scratch and archived source assets — large binaries that must not
# enter git history. `archive/` alone is 29 MB, `scratch/` is 9.7 MB.
archive/
scratch/
*.zip

# Audit output written by scripts/audit-*.ts
product-link-audit.json
product-media-audit.json

# Note: reports/ is deliberately NOT ignored. Those four JSON files are the
# V6 audit record and are already in history; ignoring a tracked path only
# creates confusion, since git keeps tracking it either way.
