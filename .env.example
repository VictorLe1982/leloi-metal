# ==============================================================================
# LELOI METAL ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# ==============================================================================

# Application Ports & URLs
NODE_ENV=development
PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Primary Brand Information
NEXT_PUBLIC_BRAND_NAME="LELOI METAL"
NEXT_PUBLIC_PARENT_BRAND="LELOI EXIM GLOBAL"
NEXT_PUBLIC_BRAND_SLOGAN="Aluminium for a Better World"
NEXT_PUBLIC_PRIMARY_DOMAIN="leloimetal.com"
NEXT_PUBLIC_CONTACT_EMAIL="contact@leloimetal.com"
NEXT_PUBLIC_SALES_EMAIL="sales@leloimetal.com"

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leloi_metal?schema=public"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# JWT Authentication & RBAC
JWT_SECRET="super-secret-jwt-key-change-in-production-leloi-metal"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="30d"

# S3-Compatible Private Storage for RFQ Engineering Drawings (AWS S3 / Cloudflare R2)
STORAGE_DRIVER=s3 # or local for development
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET_NAME="leloi-metal-confidential-rfqs"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
S3_SIGNED_URL_EXPIRES_SECONDS=900 # 15 minutes for upload, 300 for download

# Antivirus & File Security
MAX_UPLOAD_FILE_SIZE_BYTES=52428800 # 50 MB
ALLOWED_FILE_EXTENSIONS=".pdf,.dwg,.dxf,.step,.stp,.iges,.igs,.zip"

# Email Configuration (AWS SES / Resend / SMTP)
EMAIL_FROM="LELOI METAL <no-reply@leloimetal.com>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD="replace-with-smtp-api-key"

# Analytics & Observability (Public IDs)
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="XXXXXXXXXX"
