# ==============================================================================
# LELOI METAL — PUBLIC WEB APP ENVIRONMENT
# ==============================================================================
# Next.js loads .env files from this directory (apps/web), not the repo root.
# Copy to .env.local for development, and set these in your hosting provider
# for staging/production.

# Base URL of the NestJS API, including the /api prefix.
# Used by the RFQ builder, contact form and the staff portal session handler.
# Production example: https://api.leloimetal.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Canonical public origin of this site (used for absolute URLs in metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 measurement ID.
# Leave unset (or as the G-XXXX placeholder) to disable analytics and the
# consent banner entirely — useful for local and preview builds.
# Analytics runs under Consent Mode v2: nothing is sent until the visitor accepts.
NEXT_PUBLIC_GA4_ID=
